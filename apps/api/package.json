{
  "name": "@wow-locker/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PORT=3001 bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "vapid": "bun run src/db/vapid.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@vercel/functions": "^3.9.10",
    "@wow-locker/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.30",
    "node-cron": "^4.6.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/node-cron": "^3.0.11",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3"
  }
}
