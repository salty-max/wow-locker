# Local Postgres from `bun run db` (this is also the default when unset).
DATABASE_URL=postgres://wowlocker:wowlocker@localhost:5434/wowlocker

# Web Push (VAPID). Generate with `bun run --filter @wow-locker/api vapid`.
# Push is a silent no-op until all three are set. NEVER commit the private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Guards POST /api/admin/*. Unset = admin routes disabled.
CRON_SECRET=

# Optional: SCHEDULER=off disables the in-process poller; LOG_FORMAT=json|pretty.

# Battle.net API client (develop.battle.net → API Access). Required.
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=

# Public origin of the web app; Battle.net login redirects to $APP_ORIGIN/api/auth/callback,
# which must be listed in the client's redirect URLs on develop.battle.net.
APP_ORIGIN=http://localhost:5174
