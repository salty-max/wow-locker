{
  "name": "wow-locker",
  "version": "0.1.12",
  "private": true,
  "description": "WoW Classic character tracker (Hardcore-friendly) \u2014 PWA with push notifications",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:pwa": "bun run --filter @wow-locker/web build && bun run --filter @wow-locker/api start",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "turbo run test",
    "prepare": "husky",
    "db": "bash scripts/db.sh",
    "db:generate": "bun run --filter @wow-locker/api db:generate",
    "db:migrate": "bun run --filter @wow-locker/api db:migrate"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "turbo": "^2",
    "typescript-eslint": "^8.71.1"
  }
}
